                    "section": "§5",
                    "note": "sub-224-bit ECC disallowed"
                  },
                  {
                    "standard": "FIPS 203",
                    "note": "PQ migration target (ML-KEM)"
                  }
                ],
                "tags": [
                  "cryptography",
                  "post-quantum",
                  "exposure/quantum_broken",
                  "standard/NIST SP 800-186",
                  "standard/NIST SP 800-131A Rev.2",
                  "standard/FIPS 203"
                ]
              }
            },
            {
              "id": "static-rsa-kx",
              "name": "StaticRsaKx",
              "shortDescription": {
                "text": "static-RSA key exchange has no forward secrecy and is Shor-broken; the endpoint must stop offering it"
              },
              "fullDescription": {
                "text": "static-RSA key exchange has no forward secrecy and is Shor-broken; the endpoint must stop offering it"
              },
              "helpUri": "https://github.com/qramp/qramp",
              "help": {
                "text": "static-RSA key exchange has no forward secrecy and is Shor-broken; the endpoint must stop offering it\nRemediation action: decommission.\nTarget: require_forward_secrecy=True.\nReferences: RFC 8446 §1.2 (static RSA key exchange removed in TLS 1.3); NIST SP 800-131A Rev.2 (RSA broken by Shor (CRQC))."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "exposureClass": "quantum_broken",
                "references": [
                  {
                    "standard": "RFC 8446",
                    "section": "§1.2",
                    "note": "static RSA key exchange removed in TLS 1.3"
                  },
                  {
                    "standard": "NIST SP 800-131A Rev.2",
                    "note": "RSA broken by Shor (CRQC)"
                  }
                ],
                "tags": [
                  "cryptography",
                  "post-quantum",
                  "exposure/quantum_broken",
                  "standard/RFC 8446",
                  "standard/NIST SP 800-131A Rev.2"
                ]
              }
            },
