                  "standard/FIPS 205"
                ]
              }
            },
            {
              "id": "fndsa",
              "name": "Fndsa",
              "shortDescription": {
                "text": "FN-DSA (FIPS 206, Falcon) is a standardised post-quantum signature"
              },
              "fullDescription": {
                "text": "FN-DSA (FIPS 206, Falcon) is a standardised post-quantum signature"
              },
              "helpUri": "https://github.com/qramp/qramp",
              "help": {
                "text": "FN-DSA (FIPS 206, Falcon) is a standardised post-quantum signature\nReferences: FIPS 206 (draft) (FN-DSA / Falcon)."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "exposureClass": "pq_ready",
                "references": [
                  {
                    "standard": "FIPS 206 (draft)",
                    "note": "FN-DSA / Falcon"
                  }
                ],
                "tags": [
                  "cryptography",
                  "post-quantum",
                  "exposure/pq_ready",
                  "standard/FIPS 206 (draft)"
                ]
              }
            },
            {
              "id": "hybrid-pq",
              "name": "HybridPq",
              "shortDescription": {
                "text": "hybrid classical+PQ key agreement (transitional, recommended)"
              },
              "fullDescription": {
                "text": "hybrid classical+PQ key agreement (transitional, recommended)"
              },
              "helpUri": "https://github.com/qramp/qramp",
              "help": {
                "text": "hybrid classical+PQ key agreement (transitional, recommended)\nReferences: NIST SP 800-56C Rev.2 (hybrid key derivation); draft-ietf-tls-hybrid-design (hybrid KEX in TLS 1.3)."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "exposureClass": "hybrid",
                "references": [
                  {
                    "standard": "NIST SP 800-56C Rev.2",
                    "note": "hybrid key derivation"
                  },
                  {
                    "standard": "draft-ietf-tls-hybrid-design",
                    "note": "hybrid KEX in TLS 1.3"
                  }
                ],
                "tags": [
                  "cryptography",
                  "post-quantum",
                  "exposure/hybrid",
                  "standard/NIST SP 800-56C Rev.2",
                  "standard/draft-ietf-tls-hybrid-design"
                ]
              }
            },
            {
              "id": "pq-nonstandard-kem",
              "name": "PqNonstandardKem",
              "shortDescription": {
                "text": "post-quantum KEM candidate that is not (yet) FIPS-standardised (ML-KEM is the approved KEM); acceptable only as a hedge "
              },
              "fullDescription": {
                "text": "post-quantum KEM candidate that is not (yet) FIPS-standardised (ML-KEM is the approved KEM); acceptable only as a hedge alongside a standard scheme, review before production reliance\n"
              },
              "helpUri": "https://github.com/qramp/qramp",
              "help": {
                "text": "post-quantum KEM candidate that is not (yet) FIPS-standardised (ML-KEM is the approved KEM); acceptable only as a hedge alongside a standard scheme, review before production reliance\n\nTarget: require_algorithm=['ml-kem', 'hybrid-pq'].\nReferences: FIPS 203 (ML-KEM is the approved KEM; others are unstandardised); NIST IR 8413 (PQC round-3 candidates status)."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "exposureClass": "quantum_weakened",
                "references": [
                  {
                    "standard": "FIPS 203",
                    "note": "ML-KEM is the approved KEM; others are unstandardised"
                  },
                  {
                    "standard": "NIST IR 8413",
                    "note": "PQC round-3 candidates status"
                  }
                ],
                "tags": [
                  "cryptography",
                  "post-quantum",
                  "exposure/quantum_weakened",
                  "standard/FIPS 203",
                  "standard/NIST IR 8413"
                ]
              }
            },
            {
              "id": "weak-cert-signature",
              "name": "WeakCertSignature",
              "shortDescription": {
                "text": "certificate signed with a forgeable digest (SHA-1/MD5); reissue with SHA-256+ and a PQ-ready or classical-strong scheme"
              },
              "fullDescription": {
                "text": "certificate signed with a forgeable digest (SHA-1/MD5); reissue with SHA-256+ and a PQ-ready or classical-strong scheme"
              },
              "helpUri": "https://github.com/qramp/qramp",
              "help": {
                "text": "certificate signed with a forgeable digest (SHA-1/MD5); reissue with SHA-256+ and a PQ-ready or classical-strong scheme\nRemediation action: reissue.\nTarget: require_signature_hash=sha2-256.\nReferences: RFC 9155 (deprecating SHA-1 (and MD5) signatures in TLS); NIST SP 800-131A Rev.2 §9 (SHA-1 disallowed for signatures); RFC 6151 (MD5 security considerations)."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "exposureClass": "quantum_weakened",
                "references": [
                  {
                    "standard": "RFC 9155",
                    "note": "deprecating SHA-1 (and MD5) signatures in TLS"
                  },
                  {
                    "standard": "NIST SP 800-131A Rev.2",
                    "section": "§9",
                    "note": "SHA-1 disallowed for signatures"
                  },
                  {
                    "standard": "RFC 6151",
                    "note": "MD5 security considerations"
                  }
                ],
                "tags": [
                  "cryptography",
                  "post-quantum",
                  "exposure/quantum_weakened",
                  "standard/RFC 9155",
                  "standard/NIST SP 800-131A Rev.2",
                  "standard/RFC 6151"
                ]
              }
            },
            {
              "id": "weak-cert-key",
              "name": "WeakCertKey",
              "shortDescription": {
                "text": "certificate public key is below the 2048-bit RSA minimum; reissue with a stronger key"
              },
              "fullDescription": {
                "text": "certificate public key is below the 2048-bit RSA minimum; reissue with a stronger key"
              },
              "helpUri": "https://github.com/qramp/qramp",
              "help": {
                "text": "certificate public key is below the 2048-bit RSA minimum; reissue with a stronger key\nRemediation action: reissue.\nTarget: min_key_length=2048.\nReferences: NIST SP 800-131A Rev.2 §6 (RSA <2048 disallowed); NIST SP 800-57 Part 1 Rev.5 (key-length recommendations)."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "exposureClass": "quantum_weakened",
                "references": [
                  {
                    "standard": "NIST SP 800-131A Rev.2",
                    "section": "§6",
                    "note": "RSA <2048 disallowed"
                  },
                  {
                    "standard": "NIST SP 800-57 Part 1 Rev.5",
                    "note": "key-length recommendations"
                  }
                ],
                "tags": [
                  "cryptography",
                  "post-quantum",
                  "exposure/quantum_weakened",
                  "standard/NIST SP 800-131A Rev.2",
                  "standard/NIST SP 800-57 Part 1 Rev.5"
                ]
              }
            },
            {
              "id": "weak-cert-curve",
              "name": "WeakCertCurve",
              "shortDescription": {
                "text": "certificate uses a curve below the 224-bit minimum; reissue with P-256 or stronger"
              },
              "fullDescription": {
                "text": "certificate uses a curve below the 224-bit minimum; reissue with P-256 or stronger"
              },
              "helpUri": "https://github.com/qramp/qramp",
              "help": {
                "text": "certificate uses a curve below the 224-bit minimum; reissue with P-256 or stronger\nRemediation action: reissue.\nTarget: prefer=secp256r1.\nReferences: NIST SP 800-186 (approved curves (P-256+)); NIST SP 800-131A Rev.2 §5 (<224-bit ECC disallowed)."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "exposureClass": "quantum_weakened",
                "references": [
                  {
                    "standard": "NIST SP 800-186",
                    "note": "approved curves (P-256+)"
                  },
                  {
                    "standard": "NIST SP 800-131A Rev.2",
                    "section": "§5",
                    "note": "<224-bit ECC disallowed"
                  }
                ],
                "tags": [
                  "cryptography",
                  "post-quantum",
                  "exposure/quantum_weakened",
                  "standard/NIST SP 800-186",
                  "standard/NIST SP 800-131A Rev.2"
                ]
              }
            },
            {
              "id": "weak-curve-ecdsa",
              "name": "WeakCurveEcdsa",
              "shortDescription": {
                "text": "ECDSA on a sub-256-bit curve (secp160/192/224) is both below the classical 112–128-bit security floor today and Shor-bro"
              },
              "fullDescription": {
                "text": "ECDSA on a sub-256-bit curve (secp160/192/224) is both below the classical 112–128-bit security floor today and Shor-broken later; migrate off it now\n"
              },
              "helpUri": "https://github.com/qramp/qramp",
              "help": {
                "text": "ECDSA on a sub-256-bit curve (secp160/192/224) is both below the classical 112–128-bit security floor today and Shor-broken later; migrate off it now\n\nRemediation action: reissue.\nTarget: prefer=ml-dsa-or-hybrid, min_curve_bits=256.\nReferences: NIST SP 800-186 (recommended curves); NIST SP 800-131A Rev.2 §5 (sub-224-bit ECC disallowed); FIPS 204 (PQ migration target (ML-DSA))."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "exposureClass": "quantum_broken",
                "references": [
                  {
                    "standard": "NIST SP 800-186",
                    "note": "recommended curves"
                  },
                  {
                    "standard": "NIST SP 800-131A Rev.2",
                    "section": "§5",
                    "note": "sub-224-bit ECC disallowed"
                  },
                  {
                    "standard": "FIPS 204",
                    "note": "PQ migration target (ML-DSA)"
                  }
                ],
                "tags": [
                  "cryptography",
                  "post-quantum",
                  "exposure/quantum_broken",
                  "standard/NIST SP 800-186",
                  "standard/NIST SP 800-131A Rev.2",
                  "standard/FIPS 204"
                ]
              }
            },
            {
              "id": "weak-curve-ecdh",
              "name": "WeakCurveEcdh",
              "shortDescription": {
                "text": "ECDH on a sub-256-bit curve is below the classical security floor today and Shor-broken later; move to ML-KEM or a hybri"
              },
              "fullDescription": {
                "text": "ECDH on a sub-256-bit curve is below the classical security floor today and Shor-broken later; move to ML-KEM or a hybrid group\n"
              },
              "helpUri": "https://github.com/qramp/qramp",
              "help": {
                "text": "ECDH on a sub-256-bit curve is below the classical security floor today and Shor-broken later; move to ML-KEM or a hybrid group\n\nRemediation action: decommission.\nTarget: prefer=ml-kem-or-hybrid, min_curve_bits=256.\nReferences: NIST SP 800-186 (recommended curves); NIST SP 800-131A Rev.2 §5 (sub-224-bit ECC disallowed); FIPS 203 (PQ migration target (ML-KEM))."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "exposureClass": "quantum_broken",
                "references": [
                  {
                    "standard": "NIST SP 800-186",
