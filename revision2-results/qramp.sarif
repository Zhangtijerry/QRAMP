{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "QRAMP",
          "informationUri": "https://github.com/qramp/qramp",
          "version": "0.1.0",
          "rules": [
            {
              "id": "mlkem",
              "name": "Mlkem",
              "shortDescription": {
                "text": "ML-KEM (FIPS 203) is a standardised post-quantum KEM"
              },
              "fullDescription": {
                "text": "ML-KEM (FIPS 203) is a standardised post-quantum KEM"
              },
              "helpUri": "https://doi.org/10.6028/NIST.FIPS.203",
              "help": {
                "text": "ML-KEM (FIPS 203) is a standardised post-quantum KEM\nReferences: FIPS 203 (ML-KEM)."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "exposureClass": "pq_ready",
                "references": [
                  {
                    "standard": "FIPS 203",
                    "note": "ML-KEM",
                    "url": "https://doi.org/10.6028/NIST.FIPS.203"
                  }
                ],
                "tags": [
                  "cryptography",
                  "post-quantum",
                  "exposure/pq_ready",
                  "standard/FIPS 203"
                ]
              }
            },
            {
              "id": "mldsa",
              "name": "Mldsa",
              "shortDescription": {
                "text": "ML-DSA (FIPS 204) is a standardised post-quantum signature"
              },
              "fullDescription": {
                "text": "ML-DSA (FIPS 204) is a standardised post-quantum signature"
              },
              "helpUri": "https://doi.org/10.6028/NIST.FIPS.204",
              "help": {
                "text": "ML-DSA (FIPS 204) is a standardised post-quantum signature\nReferences: FIPS 204 (ML-DSA)."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "exposureClass": "pq_ready",
                "references": [
                  {
                    "standard": "FIPS 204",
                    "note": "ML-DSA",
                    "url": "https://doi.org/10.6028/NIST.FIPS.204"
                  }
                ],
                "tags": [
                  "cryptography",
                  "post-quantum",
                  "exposure/pq_ready",
                  "standard/FIPS 204"
                ]
              }
            },
            {
              "id": "slhdsa",
              "name": "Slhdsa",
              "shortDescription": {
                "text": "SLH-DSA (FIPS 205) is a standardised post-quantum signature"
              },
              "fullDescription": {
                "text": "SLH-DSA (FIPS 205) is a standardised post-quantum signature"
              },
              "helpUri": "https://doi.org/10.6028/NIST.FIPS.205",
              "help": {
                "text": "SLH-DSA (FIPS 205) is a standardised post-quantum signature\nReferences: FIPS 205 (SLH-DSA)."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "exposureClass": "pq_ready",
                "references": [
                  {
                    "standard": "FIPS 205",
                    "note": "SLH-DSA",
                    "url": "https://doi.org/10.6028/NIST.FIPS.205"
                  }
                ],
                "tags": [
                  "cryptography",
