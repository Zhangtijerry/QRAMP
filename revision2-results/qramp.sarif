            {
              "id": "weak-dh-group",
              "name": "WeakDhGroup",
              "shortDescription": {
                "text": "finite-field DH with a <=1024-bit group is breakable today by Logjam-style precomputation (in addition to being Shor-bro"
              },
              "fullDescription": {
                "text": "finite-field DH with a <=1024-bit group is breakable today by Logjam-style precomputation (in addition to being Shor-broken); the endpoint must stop offering it"
              },
              "helpUri": "https://github.com/qramp/qramp",
              "help": {
                "text": "finite-field DH with a <=1024-bit group is breakable today by Logjam-style precomputation (in addition to being Shor-broken); the endpoint must stop offering it\nRemediation action: decommission.\nTarget: min_key_length=2048, prefer=ecdhe-or-hybrid.\nReferences: RFC 7919 (FFDHE groups; avoid <2048-bit); CVE-2015-4000 (Logjam precomputation attack)."
