    {"component": "openssl", "version": "3.5.0", "expect": ["aes", "ecdh", "ml-dsa", "ml-kem", "rsa"]},
    {"component": "openssl", "version": "1.0.2u", "expect": ["aes", "ecdh", "rsa", "ssl"]},
    {"component": "bouncycastle", "version": "1.77", "expect": ["ecdsa", "rsa"]},
    {"component": "bouncycastle", "version": "1.78", "expect": ["ecdsa", "ml-dsa", "ml-kem", "rsa"]},
